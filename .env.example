# ---------------------------------------------------------------------------
# Model providers. Add at least one. Every provider with a key joins a
# fallback chain: if one is rate-limited or down, the next one is used.
# Keys stay on the server and never reach the browser.
# ---------------------------------------------------------------------------

# Google Gemini: free tier, no card. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq: free tier, very fast. https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic Claude: best reasoning quality, paid. https://console.anthropic.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=medium          # low | medium | high | xhigh | max

# OpenRouter: many community models. https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Any OpenAI-compatible endpoint, e.g. a local Ollama (what IdeaGuard v1 used).
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=gemma3:12b
# AI_LABEL=Ollama

# Provider order. Default: anthropic,gemini,groq,openrouter,custom
# AI_PROVIDERS=gemini,groq

# Tokens-per-minute to assume for Groq before its response headers report the
# real limit. Defaults to 8000 for gpt-oss (Groq's documented base-tier limit).
# GROQ_TPM=8000

# Time budget for one analysis request, in ms. Keep it below the platform's
# function limit (Vercel maxDuration is 300s for /api/analyse). Steps that
# can't start in time are paused and resumable. Default 270000.
# ANALYSIS_BUDGET_MS=270000

# Pin models instead of letting IdeaGuard pick the newest stable one.
# GEMINI_MODEL=
# GROQ_MODEL=

# ---------------------------------------------------------------------------
# Web research. Without a key, research runs "offline": the report still
# works, but every finding is labelled as model inference, not evidence.
# ---------------------------------------------------------------------------

# Tavily: 1,000 free searches a month. https://app.tavily.com
TAVILY_API_KEY=

# Brave Search API: free tier available. https://brave.com/search/api
# BRAVE_API_KEY=

# ---------------------------------------------------------------------------
# Development only. Fixed sample output (fictional companies, example.com
# sources) for working on the UI without keys. Clearly labelled in the app.
# ---------------------------------------------------------------------------
# AI_PROVIDERS=mock
# RESEARCH_PROVIDER=mock
# MOCK_DELAY_MS=700
# MOCK_FAIL=feasibility            # make an agent fail every time, to test isolation
# MOCK_FAIL_ONCE=critic            # return an invalid answer once, to test the repair pass
